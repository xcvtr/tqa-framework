# syntax=docker/dockerfile:1
# TQA-M IR Backtest Container — standalone IR strategy backtest
# Port: impulse_retrace from tqa-c → tqa-f

FROM python:3.11-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    git curl && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# ─── Production image ────────────────────────────────────────────────────────
FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Копируем зависимости от builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Копием код проекта
COPY . .

# ИЗМЕНЕНИЯ для IR-бэктеста:
# - Модуль detect из strategies/ir
# - Настройка CH FOREX подключения
# - Конфиг без комиссий/свопов
# - Script для per-ticker бэктеста с ROI/MDD

# Точка входа: скрипт полного IR-бэктеста
ENTRYPOINT ["python", "-m", "scripts.ir_backtest"]
CMD ["--help"]
